#!{{.ShellPath}}
{{.Copyright}}
# Generated by dbdeployer {{.AppVersion}} using {{.TemplateName}} on {{.DateTime}}
SBDIR={{.SandboxDir}}
RDIR="$SBDIR/mysqlrouter"
echo "MySQL Router directory: $RDIR"
if [ ! -d "$RDIR" ]
then
    echo "status: NOT DEPLOYED (no mysqlrouter subdirectory)"
    exit 0
fi
cd "$RDIR" || exit 1
FOUND=0
for PIDFILE in mysqlrouter.pid
do
    if [ ! -f "$PIDFILE" ]
    then
        continue
    fi
    PID="$(tr -d '[:space:]' <"$PIDFILE" 2>/dev/null)"
    if [ -z "$PID" ]
    then
        continue
    fi
    FOUND=1
    if kill -0 "$PID" 2>/dev/null
    then
        echo "status: RUNNING pid=$PID (from $PIDFILE)"
    else
        echo "status: STALE PID file $PIDFILE (pid=$PID not running)"
    fi
done
if [ "$FOUND" -eq 0 ]
then
    echo "status: no mysqlrouter.pid in $RDIR; checking process list:"
    FOUND_PS=0
    if PSOUT=$(LC_ALL=C ps -Ao 'pid args' 2>/dev/null)
    then
        echo "$PSOUT" | grep '[m]ysqlrouter' || true
        [ -n "$(echo "$PSOUT" | grep '[m]ysqlrouter')" ] && FOUND_PS=1
    fi
    if [ "$FOUND_PS" -eq 0 ]
    then
        PSOUT=$(LC_ALL=C ps auxww 2>/dev/null) && echo "$PSOUT" | grep '[m]ysqlrouter' || echo "(no mysqlrouter process matched)"
    fi
fi
if [ -f mysqlrouter.conf ]
then
    echo "--- quick listen summary (grep bind_*) ---"
    grep -E '^bind_' mysqlrouter.conf 2>/dev/null || true
fi
