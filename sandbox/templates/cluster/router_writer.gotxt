#!{{.ShellPath}}
{{.Copyright}}
# Generated by dbdeployer {{.AppVersion}} using {{.TemplateName}} on {{.DateTime}}
# Via MySQL Router R/W routing (classic: bootstrap_rw, typical ports 6446 / 6448 for X).
# usage: router_writer           # mysql client (classic) through Router R/W
#        router_writer x [...] # mysql Shell (mysqlx) through Router R/W
# Note: node1 my.sandbox.cnf hardcodes the server prompt; --prompt shows Router listen port.
MULTI_SB={{.SandboxDir}}
CONF="$MULTI_SB/mysqlrouter/mysqlrouter.conf"
source "$MULTI_SB/node1/sb_include"
export LD_LIBRARY_PATH=$CLIENT_LD_LIBRARY_PATH

if [ ! -f "$CONF" ]; then
	echo "MySQL Router not configured ($CONF missing). Deploy with --mysql-router." >&2
	exit 1
fi

MYSQL_PORT="$(awk '/^\[routing:bootstrap_rw\]/ {w=1;next} w && /^\[/ {exit} w && /^bind_port=/ {sub(/^bind_port=/,"");print;exit}' "$CONF")"
X_PORT="$(awk '/^\[routing:bootstrap_x_rw\]/ {w=1;next} w && /^\[/ {exit} w && /^bind_port=/ {sub(/^bind_port=/,"");print;exit}' "$CONF")"
MYSQL_HOST="$(awk '/^\[routing:bootstrap_rw\]/ {w=1;next} w && /^\[/ {exit} w && /^bind_address=/ {sub(/^bind_address=/,"");print;exit}' "$CONF")"
if [ -z "$MYSQL_HOST" ] || [ "$MYSQL_HOST" = "0.0.0.0" ]; then
	MYSQL_HOST=127.0.0.1
fi

if [ -z "$MYSQL_PORT" ]; then
	echo "Could not read classic bind_port (bootstrap_rw) from $CONF" >&2
	exit 1
fi

use_mysqlx=0
if [ "${1:-}" = "x" ]; then
	use_mysqlx=1
	if [ -z "$X_PORT" ]; then
		echo "Could not read X protocol bind_port (bootstrap_x_rw) from $CONF" >&2
		exit 1
	fi
	MYSQL_SHELL="{{.MysqlshPath}}"
	if [ -z "$MYSQL_SHELL" ]; then MYSQL_SHELL="$(command -v mysqlsh)"; fi
	if [ -z "$MYSQL_SHELL" ] || [ ! -x "$MYSQL_SHELL" ]; then
		echo "mysqlsh not found. Install MySQL Shell or deploy with --mysqlsh-path=/path/to/mysqlsh" >&2
		exit 1
	fi
	shift
	MYSQL_HOST="$(awk '/^\[routing:bootstrap_x_rw\]/ {w=1;next} w && /^\[/ {exit} w && /^bind_address=/ {sub(/^bind_address=/,"");print;exit}' "$CONF")"
	if [ -z "$MYSQL_HOST" ] || [ "$MYSQL_HOST" = "0.0.0.0" ]; then
		MYSQL_HOST=127.0.0.1
	fi
fi

MY_CNF=$SBDIR/my.sandbox.cnf
MY_CNF_NO_PASSWORD=$SBDIR/my.sandbox_np.cnf
if [ -n "$NOPASSWORD" ]; then
	grep -v '^password' <"$MY_CNF" >"$MY_CNF_NO_PASSWORD"
	MY_CNF=$MY_CNF_NO_PASSWORD
fi

if [ ! -f "$PIDFILE" ]; then
	echo "# $0: node1 sandbox not running (pidfile missing)" >&2
	exit 1
fi

if [ "$use_mysqlx" -eq 1 ]; then
	if [ -n "$NOPASSWORD" ]; then
		exec "$MYSQL_SHELL" --uri "mysqlx://{{.DbUser}}@${MYSQL_HOST}:${X_PORT}" $MYCLIENT_OPTIONS "$@"
	fi
	exec "$MYSQL_SHELL" --uri "mysqlx://{{.DbUser}}:{{.DbPassword}}@${MYSQL_HOST}:${X_PORT}" $MYCLIENT_OPTIONS "$@"
fi

[ -z "$MYSQL_EDITOR" ] && MYSQL_EDITOR="$CLIENT_BASEDIR/bin/mysql"
if [ ! -x "$MYSQL_EDITOR" ]; then
	if [ -x "$SBDIR/$MYSQL_EDITOR" ]; then
		MYSQL_EDITOR=$SBDIR/$MYSQL_EDITOR
	else
		echo "MYSQL_EDITOR '$MYSQL_EDITOR' not found or not executable" >&2
		exit 1
	fi
fi
[ -z "$MYSQL_HISTFILE" ] && export MYSQL_HISTFILE="$SBDIR/.mysql_history"

ROUTER_PS1="router-rw@${MYSQL_HOST}:${MYSQL_PORT} [\\h:\\p] {\\u} (\\d) > "
exec "$MYSQL_EDITOR" --defaults-file="$MY_CNF" --protocol=TCP --host="$MYSQL_HOST" --port="$MYSQL_PORT" \
	--prompt="$ROUTER_PS1" $MYCLIENT_OPTIONS "$@"
