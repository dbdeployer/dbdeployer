#!{{.ShellPath}}
{{.Copyright}}
# Generated by dbdeployer {{.AppVersion}} using {{.TemplateName}} on {{.DateTime}}
SBDIR={{.SandboxDir}}
RDIR="$SBDIR/mysqlrouter"
CONF="$RDIR/mysqlrouter.conf"
echo "Sandbox: $SBDIR"
if [ ! -d "$RDIR" ]
then
    echo "MySQL Router not deployed ($RDIR missing)."
    exit 1
fi
echo "Router dir:  $RDIR"
if [ ! -f "$CONF" ]
then
    echo "Missing $CONF (bootstrap may have failed)."
    exit 1
fi
echo "Config file: $CONF"
echo "--- sections + bind_* (pick bind_port for client -P) ---"
awk '/^\[/ {hdr=$0; next} /^bind_/ { print hdr, $0 }' "$CONF"
echo "--- metadata bootstrap_servers ---"
grep -E '^bootstrap_servers=' "$CONF" || true
echo "--- mysql client ---"
echo "  mysql -h127.0.0.1 -u root -p'{{.DbPassword}}' -P <bind_port_from_above>"
echo "Direct node (no Router): $SBDIR/node1/use"
echo "Router: ./status_mysql_router | ./start_mysql_router | ./stop_mysql_router"
echo "Via Router: ./router_writer | ./router_reader (append x for MySQL X / mysqlsh)"
