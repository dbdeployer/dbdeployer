#!{{.ShellPath}}
{{.Copyright}}
# Generated by dbdeployer {{.AppVersion}} using {{.TemplateName}} on {{.DateTime}}
SBDIR={{.SandboxDir}}
RDIR="$SBDIR/mysqlrouter"
if [ ! -d "$RDIR" ]
then
    echo "MySQL Router: directory not found ($RDIR)"
    exit 1
fi
cd "$RDIR" || exit 1
if [ ! -x ./stop.sh ]
then
    echo "MySQL Router: missing executable stop.sh under $RDIR"
    exit 1
fi
exec ./stop.sh "$@"
