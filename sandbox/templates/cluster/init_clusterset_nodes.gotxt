#!{{.ShellPath}}
{{.Copyright}}
# Generated by dbdeployer {{.AppVersion}} using {{.TemplateName}} on {{.DateTime}}
multi_sb={{.SandboxDir}}

{{$.SandboxDir}}/node1/mysqlsh --js -e "var c = dba.createCluster('ha_cluster', {memberSslMode: 'DISABLED'});"
{{range $index, $node := .Nodes}}
{{if and (ge $index 1) (le $index 2)}}
{{$.SandboxDir}}/node1/mysqlsh --js -e "var c = dba.getCluster(); c.addInstance('root:{{$.DbPassword}}@127.0.0.1:{{$node.NodePort}}',{recoveryMethod: 'clone'});"
{{end}}
{{end}}
{{$.SandboxDir}}/node1/mysqlsh --js -e "var c = dba.getCluster(); c.createClusterSet('msb_clusterset');"
{{$.SandboxDir}}/node1/mysqlsh --js -e "var cs = dba.getClusterSet(); cs.createReplicaCluster('dr_cluster', 'root:{{$.DbPassword}}@127.0.0.1:{{ (index .Nodes 3).NodePort }}', {recoveryMethod: 'clone'});"
{{range $index, $node := .Nodes}}
{{if ge $index 4}}
{{$.SandboxDir}}/node1/mysqlsh --js -e "var cs = dba.getClusterSet(); var rc = cs.getReplicaCluster('dr_cluster'); rc.addInstance('root:{{$.DbPassword}}@127.0.0.1:{{$node.NodePort}}',{recoveryMethod: 'clone'});"
{{end}}
{{end}}
$multi_sb/check_nodes_clusterset
