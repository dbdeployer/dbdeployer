#!{{.ShellPath}}
{{.Copyright}}
# Generated by dbdeployer {{.AppVersion}} using {{.TemplateName}} on {{.DateTime}}
SBDIR={{.SandboxDir}}
RDIR="$SBDIR/mysqlrouter"
if [ ! -d "$RDIR" ]
then
    echo "MySQL Router: directory not found ($RDIR)"
    echo "Deploy this sandbox with persistent --mysql-router (or mysql-router in defaults) so initialize_nodes_* can bootstrap Router."
    exit 1
fi
cd "$RDIR" || exit 1
if [ ! -x ./start.sh ]
then
    echo "MySQL Router: missing executable start.sh under $RDIR"
    exit 1
fi
exec ./start.sh "$@"
