#!{{.ShellPath}}
{{.Copyright}}
# Generated by dbdeployer {{.AppVersion}} using {{.TemplateName}} on {{.DateTime}}
multi_sb={{.SandboxDir}}
# workaround for Bug#89959

run_mysqlsh() {
	local shcmd="$1"
	local js="$2"
	local errf
	errf="$(mktemp)"
	if ! "$shcmd" --js -e "$js" >"$errf" 2>&1; then
		echo "mysqlsh failed: $js" >&2
		cat "$errf" >&2
		rm -f "$errf"
		exit 1
	fi
	rm -f "$errf"
}

run_mysqlsh "{{$.SandboxDir}}/node1/mysqlsh" "var cluster = dba.createCluster('msb_cluster', {memberSslMode: 'DISABLED'});"
{{range $index, $node := .Nodes}}
{{if ne $index 0}}
run_mysqlsh "{{$.SandboxDir}}/node1/mysqlsh" "var c = dba.getCluster();c.addInstance('root:{{$.DbPassword}}@127.0.0.1:{{$node.NodePort}}',{recoveryMethod: 'clone'});"
{{end}}
{{end}}

{{ if $.MysqlRouterExe }}
ROUTER_DIR="$multi_sb/mysqlrouter"
ROUTER_EXE="{{$.MysqlRouterExe}}"
rm -rf "$ROUTER_DIR"
mkdir -p "$ROUTER_DIR"
ROUTER_TAG="$( "$ROUTER_EXE" --version 2>/dev/null | head -n 1 )"
echo "# Bootstrapping $ROUTER_TAG instance at '$ROUTER_DIR'..."
if ! "$ROUTER_EXE" --bootstrap "root:{{$.DbPassword}}@127.0.0.1:{{(index $.Nodes 0).NodePort}}" --directory "$ROUTER_DIR" --force >/dev/null 2>"$ROUTER_DIR/_bootstrap.err"
then
	cat "$ROUTER_DIR/_bootstrap.err" >&2
	exit 1
fi
rm -f "$ROUTER_DIR/_bootstrap.err"
CONF="$ROUTER_DIR/mysqlrouter.conf"
echo ""
echo "InnoDB Cluster 'msb_cluster' can be reached by connecting to:"
echo ""
echo "## MySQL Classic protocol"
echo ""
c_rw="$(awk '/^\[routing:bootstrap_rw\]/ {w=1;next} w && /^\[/ {exit} w && /^bind_port=/ {sub(/^bind_port=/,"");print;exit}' "$CONF")"
c_ro="$(awk '/^\[routing:bootstrap_ro\]/ {w=1;next} w && /^\[/ {exit} w && /^bind_port=/ {sub(/^bind_port=/,"");print;exit}' "$CONF")"
echo "- Read/Write Connections: localhost:${c_rw:-?}"
echo "- Read/Only Connections:  localhost:${c_ro:-?}"
echo ""
echo "## MySQL X protocol"
echo ""
x_rw="$(awk '/^\[routing:bootstrap_x_rw\]/ {w=1;next} w && /^\[/ {exit} w && /^bind_port=/ {sub(/^bind_port=/,"");print;exit}' "$CONF")"
x_ro="$(awk '/^\[routing:bootstrap_x_ro\]/ {w=1;next} w && /^\[/ {exit} w && /^bind_port=/ {sub(/^bind_port=/,"");print;exit}' "$CONF")"
echo "- Read/Write Connections: localhost:${x_rw:-?}"
echo "- Read/Only Connections:  localhost:${x_ro:-?}"
if [ -x "$ROUTER_DIR/start.sh" ]
then
	"$ROUTER_DIR/start.sh" >/dev/null 2>&1 || exit 1
fi
{{ end }}

$multi_sb/check_nodes_cluster
